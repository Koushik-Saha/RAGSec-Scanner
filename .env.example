# Copy to .env and fill in. Never commit .env.
# Model provider: anthropic (default), groq, openrouter, or ollama.
RAGSEC_PROVIDER=anthropic
# Only the selected provider's key is needed (ollama needs none).
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GROQ_API_KEY=your-groq-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
# Model name for the selected provider.
RAGSEC_MODEL=claude-opus-5-5
RAGSEC_DATA_DIR=./data
RAGSEC_CHROMA_DIR=./chroma
RAGSEC_REPORTS_DIR=./reports
